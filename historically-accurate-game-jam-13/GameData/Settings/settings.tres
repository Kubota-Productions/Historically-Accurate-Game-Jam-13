[gd_resource type="Resource" script_class="SettingsCatalog" format=3]

[ext_resource type="Script" path="res://Code/Definitions/settings_catalog.gd" id="catalog"]
[ext_resource type="Script" path="res://Code/Definitions/setting_definition.gd" id="setting"]
[ext_resource type="Script" path="res://Code/Definitions/toggle_setting.gd" id="toggle"]
[ext_resource type="Script" path="res://Code/Definitions/slider_setting.gd" id="slider"]

[sub_resource type="Resource" id="dog_vision"]
resource_name = "Dog vision"
script = ExtResource("toggle")
default_value = true
id = &"dog_vision"
label = "Dog vision"

[sub_resource type="Resource" id="panini_projection"]
resource_name = "Panini projection"
script = ExtResource("toggle")
default_value = true
id = &"panini_projection"
label = "Panini projection"

[sub_resource type="Resource" id="sound_volume"]
resource_name = "Sound volume"
script = ExtResource("slider")
default_value = 0.7
audio_bus = &"Sound"
id = &"sound_volume"
label = "Sound volume"
section = 1

[sub_resource type="Resource" id="music_volume"]
resource_name = "Music volume"
script = ExtResource("slider")
default_value = 0.7
audio_bus = &"Music"
id = &"music_volume"
label = "Music volume"
section = 1

[sub_resource type="Resource" id="sensitivity"]
resource_name = "Mouse sensitivity"
script = ExtResource("slider")
default_value = 0.1
minimum = 0.03
maximum = 0.3
percent = false
id = &"sensitivity"
label = "Mouse sensitivity"
section = 2

[resource]
script = ExtResource("catalog")
settings = Array[ExtResource("setting")]([SubResource("dog_vision"), SubResource("panini_projection"), SubResource("sound_volume"), SubResource("music_volume"), SubResource("sensitivity")])
